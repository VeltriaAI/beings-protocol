#!/usr/bin/env bash
# owner-read: READ-ONLY view of the owner's Teams via the owner's delegate cache. Never sends.
#   owner-read --find <name> | --list [--top N] | --chat <chatId> [--top N] | <upn>
set -euo pipefail
KIT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
[[ "${BEING_SEND_SCOPE:-}" == chats:* ]] && { echo "blocked: teammate runs cannot read the owner's chats" >&2; exit 3; }
set -a
# shellcheck source=/dev/null
. "$KIT/.env"
set +a
[[ -s "${OWNER_CACHE:-}" ]] || { echo "no owner delegate sign-in (OWNER_CACHE)" >&2; exit 1; }
BEING_CACHE="$OWNER_CACHE" exec node "$KIT/teams-read.mjs" --as "$OWNER_UPN" "$@"
