# Copy to .env (chmod 600, never commit), fill, then: set -a; . ./.env; set +a
# The file is sourced by bash: quote any value with spaces or quotes, e.g. OWNER_NAME='Sam Lee'.
# ---- Being identity (its own Microsoft 365 account) ----
BEING_NAME=nova                       # name people use in chat; matched as a word in group messages
BEING_UPN=                            # the Being's sign-in, e.g. nova@your-tenant.example
BEING_STATE_DIR=                      # absolute path to <kit>/state (gitignored)
BEING_CACHE=                          # absolute path to <kit>/state/token-cache.json (0600, never share)
BEING_COMMS_LOG=                      # optional; default <state>/comms.jsonl
# ---- Owner (the human partner) ----
OWNER_NAME=                           # how prompts refer to the owner
OWNER_UPN=
OWNER_OID=                            # owner's object id: teams-read.mjs --whoami run with the owner cache
BEING_OWNER_DELEGATE=0                # 1 = allow the owner delegate sign-in below. OFF by default: GUARDRAILS.md "Threat model"
OWNER_CACHE=                          # owner's delegate cache for owner-read/owner-mail/approve; separate file, two-user host only
# ---- Entra app registration (public client, delegated permissions) ----
M365_CLIENT_ID=
M365_TENANT_ID=
# ---- Model routing (see docs/MODEL_ROUTING.md) ----
BEING_FAST_CLIENT=codex               # triage + voice: codex | claude
BEING_FAST_MODEL=haiku                # used when BEING_FAST_CLIENT=claude
BEING_FAST_EFFORT=low                 # used when BEING_FAST_CLIENT=codex
BEING_SESSION_MODEL=opus              # daily work session
BEING_JOB_MODEL=opus                  # big jobs: research, reviews, multi-step builds
BEING_JOB_MODEL_SMALL=sonnet          # small jobs: lookups, account chores, probes (being-job --small)
# ---- Runner ----
BEING_TICK_SEC=30
BEING_STALL_MIN=10                    # watchdog: alert after this many idle minutes
BEING_MAIL_WATCH=1                    # 0 disables the mailbox watcher
BEING_DETECT_CHATS=50                 # chats swept per tick, most recently active first (README "Detection limits")
BEING_DETECT_MESSAGES=8               # newest messages read per chat per tick (max 50)
# ---- Isolation (GUARDRAILS.md "Threat model") ----
BEING_MODEL_USER=                     # OS user the model runs as, if not this one; checked by being-teams doctor
