#!/usr/bin/env python3
"""being-status: what the Being is doing right now, from live state only (no model).
   being-status [--actions N]   running work + latest actions, queue, jobs, blockers in the last 24 h"""
import glob, json, os, re, sys, time, uuid
from datetime import datetime

KIT = os.path.dirname(os.path.realpath(__file__))
# Run standalone too: fill missing settings from the kit's .env.
if os.path.exists(os.path.join(KIT, ".env")):
    for l in open(os.path.join(KIT, ".env")):
        k, _, v = l.split("#", 1)[0].strip().partition("=")
        if k and v.strip(): os.environ.setdefault(k, v.strip())
STATE = os.environ.get("BEING_STATE_DIR") or sys.exit("BEING_STATE_DIR not set")
NAME = os.environ.get("BEING_NAME", "being")
WORKSPACE = os.environ.get("BEING_WORKSPACE") or os.path.dirname(os.path.dirname(KIT))
CLAUDE_DIR = os.path.expanduser("~/.claude/projects/" + re.sub(r"[/.]", "-", os.path.realpath(WORKSPACE)))
N = int(sys.argv[sys.argv.index("--actions") + 1]) if "--actions" in sys.argv else 8

def ago(ts):
    s = int(time.time() - ts); return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"

def lines(pattern):
    out = []
    for f in glob.glob(pattern):
        out += [json.loads(l) for l in open(f) if l.strip()]
    return out

def brief(m):
    if m.get("lane") == "job": return f"job {m.get('name')} finished ({m.get('status')})"
    return f"{m.get('from', '?')}: “{(m.get('text') or '')[:90]}”"

def actions(path, since):
    """Latest tool calls from a Claude Code transcript after `since` (epoch)."""
    acts = []
    try:
        for l in open(path):
            try: e = json.loads(l)
            except ValueError: continue
            ts = e.get("timestamp")
            if not ts or datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() < since: continue
            for c in (e.get("message") or {}).get("content") or []:
                if isinstance(c, dict) and c.get("type") == "tool_use":
                    i = c.get("input") or {}
                    what = i.get("description") or i.get("file_path") or i.get("command") or i.get("pattern") or ""
                    acts.append(f"{ts[11:16]}Z {c.get('name')}: {' '.join(str(what).split())[:100]}")
    except FileNotFoundError:
        pass
    return acts[-N:]

print(f"{NAME} status · {datetime.now().astimezone():%Y-%m-%d %H:%M %Z}\n")
sid = str(uuid.uuid5(uuid.NAMESPACE_URL, f"being-daily/{NAME}/{datetime.now():%Y-%m-%d}"))
running = False
for bf in sorted(glob.glob(os.path.join(STATE, "work.*.jsonl"))):
    pid = bf.rsplit(".", 2)[-2]
    if not pid.isdigit() or not os.path.exists(f"/proc/{pid}"): continue
    running, start = True, os.path.getmtime(bf)
    print(f"▶ WORKING (daily session, {ago(start)} so far) on:")
    for m in lines(os.path.join(STATE, f"work-*.{pid}.jsonl")) or lines(bf): print(f"   - {brief(m)}")
    for a in actions(os.path.join(CLAUDE_DIR, sid + ".jsonl"), start): print(f"   · {a}")
    print()
if not running: print("▶ Daily session: idle\n")

queued = lines(os.path.join(STATE, "queue.jsonl")) + lines(os.path.join(STATE, "work.jsonl"))
print(f"⏳ Waiting: {len(queued)}")
for m in queued: print(f"   - {brief(m)}")

jobs = sorted(glob.glob(os.path.join(STATE, "jobs", "*.json")), key=os.path.getmtime, reverse=True)[:8]
print(f"\n🧰 Jobs: {len(jobs) or 'none'}")
for jf in jobs:
    d = json.load(open(jf))
    st = datetime.fromisoformat(d["started"]).timestamp()
    print(f"   - {d['name']} [{d['kind']}] {d['status']}" + (f", running {ago(st)}" if d["status"] == "running"
          else f", exit {d.get('exit')}, finished {d.get('finished', '')[11:16]}"))
    if d["status"] == "running" and d["kind"] == "agent" and d.get("session_id"):
        for a in actions(os.path.join(CLAUDE_DIR, d["session_id"] + ".jsonl"), st)[-3:]: print(f"     · {a}")

bl = os.path.join(STATE, "blockers.jsonl")
recent = [b for b in (lines(bl) if os.path.exists(bl) else []) if time.time() - datetime.fromisoformat(b["at"]).timestamp() < 86400]
print(f"\n🚧 Blockers (24 h): {len(recent) or 'none'}")
for b in recent[-5:]: print(f"   - {b['at'][11:16]} {b['task']}: {b['error'][:90]} → needs: {b['need'][:80]}")
